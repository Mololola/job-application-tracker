generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  APPLIED
  REJECTED
  INTERVIEW
  AI_INTERVIEW
  CODING_TASK
  ASSESSMENT
  OFFER
  WITHDRAWN
  UNKNOWN
}

enum EventType {
  APPLICATION_CONFIRMED
  REJECTION_RECEIVED
  INTERVIEW_INVITE
  AI_INTERVIEW_INVITE
  CODING_TEST_RECEIVED
  ASSESSMENT_RECEIVED
  FOLLOW_UP
  OFFER_RECEIVED
  GENERAL_UPDATE
}

enum TaskType {
  AI_INTERVIEW
  NORMAL_INTERVIEW
  CODING_TASK
  ASSESSMENT
  OTHER
}

enum TaskStatus {
  TODO
  DONE
  CANCELLED
}

enum ReviewStatus {
  PENDING
  CONFIRMED
  IGNORED
}

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  gmailAccessToken     String?
  gmailRefreshToken    String?
  gmailTokenExpiry     DateTime?
  lastSyncedAt         DateTime?
  gmailHistoryId       String?
  gmailWatchExpiration DateTime?
  gmailPushEnabled     Boolean          @default(false)
  gmailWatchTopicName  String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  applications         Application[]
  emailCandidates      EmailCandidate[]
  syncLogs             SyncLog[]
  decisionLogs         DecisionLog []
}

model Application {
  id         String             @id @default(cuid())
  userId     String
  company    String
  position   String
  status     ApplicationStatus  @default(UNKNOWN)
  source     String             @default("gmail")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events     ApplicationEvent[]
  tasks      Task[]
  candidates EmailCandidate[]

  companyNormalized String?           
  refIdsJson        String?            
  senderDomainsJson String?            
  atsSlugsJson      String?   

  @@index([userId])
  @@index([company])
  @@index([companyNormalized]) 
  @@index([status])
}

model ApplicationEvent {
  id             String      @id @default(cuid())
  applicationId  String
  type           EventType
  emailSubject   String?
  emailFrom      String?
  emailDate      DateTime?
  gmailMessageId String?
  summary        String?
  confidence     Float       @default(0)
  deadline       DateTime?
  createdAt      DateTime    @default(now())
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([type])
  @@index([gmailMessageId])
}

model Task {
  id            String     @id @default(cuid())
  applicationId String
  type          TaskType
  title         String
  deadline      DateTime?
  status        TaskStatus @default(TODO)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([deadline])
}

model DecisionLog {
  id                   String             @id @default(cuid())
  userId               String

  // email identity
  gmailMessageId       String?
  emailThreadId        String?
  emailSubject         String?
  emailFrom            String?
  emailDate            DateTime?

  // final routing decision (DecisionOutcome union in lib/decision-log.ts)
  decision             String
  reason               String?
  trigger              String?            // 'push' | 'watch_catchup' | 'reprocess' | 'manual_review' | ...

  // classification snapshot (denormalized for fast filtering on the debug page)
  eventType            EventType?
  status               ApplicationStatus?
  confidence           Float?

  // extraction snapshot
  company              String?
  position             String?
  refIdsJson           String?            // JSON string[] of normalized reference tokens

  // matching snapshot
  matchedApplicationId String?
  bestScore            Float?
  secondScore          Float?
  scoreGap             Float?

  // full structured trace (JSON DecisionTrace) for /debug/decisions
  trace                String?

  createdAt            DateTime           @default(now())
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([gmailMessageId])
  @@index([decision])
}

model EmailCandidate {
  id             String            @id @default(cuid())
  userId         String
  applicationId  String?
  gmailMessageId String            @unique
  emailThreadId  String?
  emailSubject   String?
  emailFrom      String?
  emailDate      DateTime?
  snippet        String?
  bodyPreview    String?
  company        String?
  position       String?
  status         ApplicationStatus @default(UNKNOWN)
  eventType      EventType         @default(GENERAL_UPDATE)
  taskType       TaskType?
  deadline       DateTime?
  summary        String?
  confidence     Float             @default(0)
  reviewStatus   ReviewStatus      @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  application    Application?      @relation(fields: [applicationId], references: [id])

  refIdsJson       String?           
  messageIdHeader  String?           
  inReplyToHeader  String?          
  referencesHeader String?           

  @@index([userId])
  @@index([reviewStatus])
  @@index([status])
}

model SyncLog {
  id        String   @id @default(cuid())
  userId    String
  trigger   String
  message   String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trigger])
  @@index([createdAt])
}
